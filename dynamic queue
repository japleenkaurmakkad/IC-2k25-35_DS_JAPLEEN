#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* next;
    Node(int val) : data(val), next(nullptr) {}
};

class DynamicQueue {
    Node *front, *rear;
public:
    DynamicQueue() { front = rear = nullptr; }

    void push(int x) {
        Node* newNode = new Node(x);
        if (rear == nullptr) {
            front = rear = newNode;
            return;
        }
        rear->next = newNode;
        rear = newNode;
    }

    void pop() {
        if (front == nullptr) { 
            cout << "Queue Underflow!\n"; 
            return; 
        }
        Node* temp = front;
        front = front->next;
        if (front == nullptr) rear = nullptr;
        delete temp;
    }

    void display() {
        Node* temp = front;
        while (temp != nullptr) {
            cout << temp->data << " ";
            temp = temp->next;
        }
        cout << "\n";
    }
};

int main() {
    DynamicQueue q;
    q.push(100); q.push(200); q.push(300);
    cout << "Dynamic Queue: ";
    q.display();
    q.pop();
    cout << "After Pop: ";
    q.display();
    return 0;
}
