#include <iostream>
using namespace std;

int main() {
    int rows=3,cols=3;
    int A[3][3]={
        {5,6,7},
        {1,2,3},
        {8,7,6}
    };
    int B[3][3]={
        {4,5,6},
        {1,8,9},
        {4,3,2}
    };
    int sum[3][3];
    
    for(int i=0;i<rows;i++){
        for(int j=0;j<cols;j++){
         sum[i][j]= A[i][j] + B[i][j];
        }
    }
    cout<<"result of matrix addition:"<<endl;
    for(int i=0;i<rows;i++){
        for(int j=0;j<cols;j++){
            cout<<sum[i][j]<<" ";
        }
        cout<<endl;//to make proper matrix it is must
    }
    return 0;
}
