#include<iostream>
using namespace std;

int main(){
    int rows=2,cols=3;
    int matrix[2][3]={
        {2,5,8},
        {4,6,1}
    };
    int transpose[3][2];
    for (int i=0;i<rows;i++){
        for( int j=0;j<cols;j++){
            transpose[j][i]=matrix[i][j];
        }
    }
    cout<<"Original matrix:"<<endl;
    for (int i=0;i<rows;i++){
        for (int j=0;j<cols;j++){
            cout<<matrix[i][j]<<" ";
        }
        cout<<endl;
    }
    cout<<"\nTranspose matrix:"<<endl;
    for (int i=0;i<cols;i++){
        for (int j=0;j<rows;j++){
            cout<<transpose[i][j]<<" ";
        }
        cout<<endl;
    }
    return 0;
}
