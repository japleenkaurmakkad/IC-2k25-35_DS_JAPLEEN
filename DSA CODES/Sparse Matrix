#include <iostream>
using namespace std;

int main() {
    int a[3][3];
    cout<<"Enter 3.3 matrix:\n";
    
    for(int i=0;i<3;i++)
    for(int j=0;j<3;j++)
    cin>>a[i][j];
    
    cout<<"Row\tColumn\tValue"<<endl;
    for(int i=0;i<3;i++){
        for (int j=0;j<3;j++){
            if (a[i][j]!=0){
            cout<<i<<"\t"<<j<<"\t\t"<<a[i][j]<<endl;
        }
    }
}
    return 0;
}
