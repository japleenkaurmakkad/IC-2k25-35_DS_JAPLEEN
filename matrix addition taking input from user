#include <iostream>
using namespace std;

int main() {
    int rows,cols;
    cout<<"Enter number of rows & columns:";
    cin>>rows>>cols;
    
    //matrix upto 10.10
    int A[10][10],B[10][10],sum[10][10];
    
    cout<<"\nMatrix A:\n";3
    for(int i=0;i<rows;i++){
        for(int j=0;j<cols;j++){
            cin>>A[i][j];
        }
    }
    
    cout<<"\nMatrix B:\n";
    for(int i=0;i<rows;i++){
        for(int j=0;j<cols;j++){
            cin>>B[i][j];
        }
    }
    
    for(int i=0;i<rows;i++){
        for(int j=0;j<cols;j++){
         sum[i][j]= A[i][j] + B[i][j];
        }
    }
    cout<<"\nsum of matrices:\n";
    for(int i=0;i<rows;i++){
        for(int j=0;j<cols;j++){
            cout<<sum[i][j]<<" ";
        }
        cout<<endl;//to make proper matrix it is must
    }
    return 0;
}
